# API
# Optional. Defaults to https://api.thrivo.fit when unset.
# EXPO_PUBLIC_API_URL=https://api.thrivo.fit

# Clerk — REQUIRED (auth won't function without this).
# Use the BeOrchid Consumer Clerk application's publishable key.
# EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...

# Native Google Sign-In (Clerk `@clerk/expo/google`) — OPTIONAL.
# When unset, the "Continue with Google" button is hidden (no crash). Set all
# three to enable the native credential-picker flow. Requires a Google Cloud
# OAuth Web + iOS + Android client, and Clerk → Google connection with "Use
# custom credentials" (paste the Web client ID + secret). The Android client is
# matched by package name + SHA-1 in Google Cloud, so it has no runtime var here.
# Web client ID — required on both platforms.
# EXPO_PUBLIC_CLERK_GOOGLE_WEB_CLIENT_ID=...apps.googleusercontent.com
# iOS client ID — required on iOS.
# EXPO_PUBLIC_CLERK_GOOGLE_IOS_CLIENT_ID=...apps.googleusercontent.com
# iOS URL scheme = the iOS client ID reversed (com.googleusercontent.apps.<id>).
# Build-time only: consumed by the @clerk/expo-google-signin config plugin to add
# the Info.plist URL scheme. Not read at runtime.
# EXPO_PUBLIC_CLERK_GOOGLE_IOS_URL_SCHEME=com.googleusercontent.apps....

# Observability — REQUIRED in production builds (the app refuses to boot without
# them in a release bundle; optional in development). These EXPO_PUBLIC_* values
# are public client keys and must be set in Expo for preview/production builds.
# Sentry crash reporting DSN.
# EXPO_PUBLIC_SENTRY_DSN=
# PostHog product analytics. Host defaults to https://us.i.posthog.com.
# EXPO_PUBLIC_POSTHOG_KEY=
# EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Sentry source map upload — REQUIRED for readable production/preview stack traces.
# Set this in Expo/EAS as a Secret, not as an EXPO_PUBLIC_* value.
# SENTRY_AUTH_TOKEN=
