{
  "expo": {
    "name": "Thrivo",
    "slug": "thrivo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "primaryColor": "#09823C",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/d24d4616-0673-459c-9d34-ced491ef777e"
    },
    "assetBundlePatterns": ["**/*"],
    "splash": {
      "image": "./src/assets/splash-new.png",
      "resizeMode": "contain",
      "backgroundColor": "#F4F6F9"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.beorchid.thrivo",
      "associatedDomains": ["applinks:thrivo.fit"],
      "usesAppleSignIn": true,
      "splash": {
        "image": "./src/assets/splash-new.png",
        "resizeMode": "contain",
        "backgroundColor": "#F4F6F9"
      }
    },
    "android": {
      "package": "com.beorchid.thrivo",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            { "scheme": "https", "host": "thrivo.fit", "pathPrefix": "/dashboard" },
            { "scheme": "https", "host": "thrivo.fit", "pathPrefix": "/log" },
            { "scheme": "https", "host": "thrivo.fit", "pathPrefix": "/metrics" },
            { "scheme": "https", "host": "thrivo.fit", "pathPrefix": "/settings/subscription" }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "CAMERA",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED",
        "SCHEDULE_EXACT_ALARM"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION"
      ],
      "splash": {
        "image": "./src/assets/splash-new.png",
        "resizeMode": "contain",
        "backgroundColor": "#F4F6F9"
      }
    },
    "web": {
      "favicon": "./src/assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Thrivo to use your camera to scan and log foods.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Thrivo to access your photos to set a profile picture."
        }
      ],
      "expo-apple-authentication",
      [
        "expo-notifications",
        {
          "color": "#09823C",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Allow Thrivo to use Face ID to unlock your saved login."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Thrivo to use Face ID to unlock your saved login."
        }
      ],
      "expo-web-browser",
      "@react-native-community/datetimepicker",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "organization": "beorchid-llc",
          "project": "thrivo"
        }
      ],
      "expo-localization",
      "@clerk/expo",
      "@clerk/expo-google-signin",
      [
        "expo-build-properties",
        {
          "android": {
            "packagingOptions": {
              "pickFirst": ["META-INF/versions/9/OSGI-INF/MANIFEST.MF"]
            }
          }
        }
      ]
    ],
    "scheme": "thrivo",
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "d24d4616-0673-459c-9d34-ced491ef777e"
      }
    },
    "experiments": {
      "typedRoutes": true
    },
    "owner": "beorchid-llc"
  }
}
